<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\Shared.props" />

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>


  <PropertyGroup>
    <Description>This Library provides an Aspire Supabase solution</Description>
    <PackageTags>Aspire, extensions</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nextended.Aspire\Nextended.Aspire.csproj" />
    <ProjectReference Include="..\Nextended.Aspire.Hosting.Grafana\Nextended.Aspire.Hosting.Grafana.csproj" />
    <PackageReference Include="Aspire.Hosting.Azure.AppContainers" />
    <PackageReference Include="Aspire.Hosting.Azure.Storage" />
    <PackageReference Include="Aspire.Hosting.Azure.Network" />
    <PackageReference Include="Aspire.Hosting.Docker" />
    <!-- Required by the optional external-database overload of AddSupabase(...), whose public
         signature exposes IResourceBuilder<PostgresServerResource> so callers can pass their own
         builder.AddPostgres(...) resource. -->
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="supabase-csharp" />
    <!-- supabase-csharp pulls IdentityModel 7.0.3 transitively, which has a known moderate JWT
         vulnerability (GHSA-59j7-ghrg-fj52). These two references exist only to lift it onto the
         patched version - see Directory.Packages.props for which one, and why not 8.x. -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
  </ItemGroup>

</Project>
