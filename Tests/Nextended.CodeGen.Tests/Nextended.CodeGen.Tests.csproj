<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Newtonsoft.Json" />
    <!-- ClosedXML (the Excel generation) needs it at run time; the generator's reference is private -->
    <PackageReference Include="DocumentFormat.OpenXml" />
    <!-- Mapperly is only loaded to run its generator over the generated mapper inside the tests -->
    <PackageReference Include="Riok.Mapperly" GeneratePathProperty="true" ExcludeAssets="all" />
    <Reference Include="$(PkgRiok_Mapperly)\analyzers\roslyn4.11\dotnet\cs\Riok.Mapperly.dll" />
    <Reference Include="$(PkgRiok_Mapperly)\analyzers\roslyn4.11\dotnet\cs\Riok.Mapperly.Abstractions.dll" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Nextended.CodeGen\Nextended.CodeGen.csproj" />
  </ItemGroup>

</Project>
