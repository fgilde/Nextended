<Project Sdk="Microsoft.NET.Sdk">

  <Sdk Name="Aspire.AppHost.Sdk" Version="13.4.6" />
  <Import Project="..\..\..\Version.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAspireHost>true</IsAspireHost>
    <IsPackable>false</IsPackable>
    <UserSecretsId>nextended-webdatastudio-apphost-9c31a7e4</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="$(AspireVersion)" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="$(AspireVersion)" />
    <PackageReference Include="Aspire.Hosting.SqlServer" Version="$(AspireVersion)" />
    <PackageReference Include="Aspire.Hosting.MongoDB" Version="$(AspireVersion)" />
    <PackageReference Include="Aspire.Hosting.Redis" Version="$(AspireVersion)" />
    <PackageReference Include="Aspire.Hosting.Azure.Storage" Version="$(AspireVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The seed script has to sit next to the binary for the container mount to find it. -->
    <None Include="init\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- The export templates are mounted into the studio, so they have to sit next to the binary. -->
    <None Include="export-templates\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Nextended.Aspire.Hosting.WebDataStudio\Nextended.Aspire.Hosting.WebDataStudio.csproj" IsAspireProjectResource="false" />
  </ItemGroup>

</Project>
