<Project Sdk="Microsoft.NET.Sdk">

  <Sdk Name="Aspire.AppHost.Sdk" Version="13.4.6" />
  <Import Project="..\..\..\Version.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAspireHost>true</IsAspireHost>
    <IsPackable>false</IsPackable>
    <UserSecretsId>nextended-webdatastudio-apphost-9c31a7e4</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="$(AspireVersion)" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="$(AspireVersion)" />
    <PackageReference Include="Aspire.Hosting.SqlServer" Version="$(AspireVersion)" />
    <PackageReference Include="Aspire.Hosting.MongoDB" Version="$(AspireVersion)" />
    <PackageReference Include="Aspire.Hosting.Redis" Version="$(AspireVersion)" />
    <PackageReference Include="Aspire.Hosting.Azure.Storage" Version="$(AspireVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The seed script has to sit next to the binary for the container mount to find it. -->
    <None Include="init\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- The export templates are mounted into the studio, so they have to sit next to the binary. -->
    <None Include="export-templates\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- The realm Keycloak imports on the first start, mounted the same way. -->
    <None Include="keycloak\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- The documents MongoDB imports on its first start. -->
    <None Include="mongo-init\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Northwind, for the server the clone reads from. -->
    <None Include="northwind\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Northwind, for the server the clone reads from. -->
    <!-- One seed script per connection, for the engines that cannot seed themselves. -->
    <None Include="seed\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- The Grafana dashboard on the same database, mounted into Grafana's provisioning. -->
    <None Include="grafana-dashboards\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- The saved queries the studio imports at start. -->
    <None Include="queries\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Files for the folder-as-a-bucket connection: CSV, NDJSON, JSON, Markdown, a PDF, a PNG. -->
    <None Include="drop\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Nextended.Aspire.Hosting.WebDataStudio\Nextended.Aspire.Hosting.WebDataStudio.csproj" IsAspireProjectResource="false" />
    <!-- Cloning a database into this stack: the northwind copy below. -->
    <ProjectReference Include="..\..\..\Nextended.Aspire.Hosting.DbTools\Nextended.Aspire.Hosting.DbTools.csproj" IsAspireProjectResource="false" />
    <!-- Grafana and the studio in one stack: two windows onto the same database resource. -->
    <ProjectReference Include="..\..\..\Nextended.Aspire.Hosting.Grafana\Nextended.Aspire.Hosting.Grafana.csproj" IsAspireProjectResource="false" />
  </ItemGroup>

</Project>
