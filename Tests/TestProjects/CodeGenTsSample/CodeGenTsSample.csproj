<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The TypeScript generation sample: C# contracts (Contracts/) and a fluent configuration (CodeGen/TsCodeGen.cs) with two TypeScript
    generations, ts/ (ABP preset, enums, namespace folders) and ts-const/ (Coworkee preset, const objects, flat).
    The API types come from the in-tree Nextended.Core until a release carries them; ts/ and ts-const/ are produced by
    Tests/Nextended.CodeGen.Tests (TypescriptSampleTests) and checked with `tsc - -strict` there. With released packages that know the
    TypeScript generation, reference them instead (see CodeGenSample) and the generator writes the folders on every build.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Nextended.Core\Nextended.Core.csproj" />
  </ItemGroup>
</Project>
