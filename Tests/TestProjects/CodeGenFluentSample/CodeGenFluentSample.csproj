<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The fluent configuration sample: plain entities (no attributes), configured in CodeGen/*.cs.
    The API types come from the in-tree Nextended.Core until a release carries them; the files in Generated/ are produced by
    Tests/Nextended.CodeGen.Tests (SampleGoldenTests.Fluent_sample_output_is_unchanged) and compiled here as normal sources.
    With a released Nextended.Core and Nextended.CodeGen that know the fluent configuration, reference the packages instead
    (see CodeGenSample) and the generator writes Generated/ on every build.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Nextended.Core\Nextended.Core.csproj" />
  </ItemGroup>
</Project>
