{
  "realm": "nextended",
  "enabled": true,
  "sslRequired": "none",
  "roles": {
    "client": {
      "signoz": [
        {
          "name": "admin",
          "description": "Signs in to SigNoz (as its admin)"
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "signoz",
      "name": "SigNoz",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "nextended-sample-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:*"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:*"
      }
    }
  ],
  "users": [
    {
      "username": "ada",
      "email": "ada@example.com",
      "firstName": "Ada",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "ada",
          "temporary": false
        }
      ],
      "clientRoles": {
        "signoz": [
          "admin"
        ]
      }
    },
    {
      "username": "nora",
      "email": "nora@example.com",
      "firstName": "Nora",
      "lastName": "Norole",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "nora",
          "temporary": false
        }
      ]
    }
  ]
}
