              "width": 6,
              "height": 6,
              "content": {
                "$ref": "#/spec/panels/f9ad756b-fc37-5bed-8f31-c4df86af9658"
              }
            }
          ],
          "display": {
            "title": "Calls and latency"
          }
        }
      },
      {
        "kind": "Grid",
        "spec": {
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 12,
              "height": 7,
              "content": {
                "$ref": "#/spec/panels/8c34fd93-1389-554e-90af-a6c5482f256a"
              }
            },
            {
              "x": 0,
              "y": 7,
              "width": 6,
              "height": 6,
              "content": {
                "$ref": "#/spec/panels/873dbb3c-5f0a-50ed-9857-3efdea8cce7a"
              }
            }
          ],
          "display": {
            "title": "Statements"
          }
        }
      }
    ],
    "duration": "1h",
    "refreshInterval": "30s",
    "links": []
  }
}
