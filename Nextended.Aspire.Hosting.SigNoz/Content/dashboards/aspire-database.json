              "content": {
                "$ref": "#/spec/panels/2c1f3e58-34fc-50fe-a22b-062ec613a9e5"
              }
            }
          ]
        }
      },
      {
        "kind": "Grid",
        "spec": {
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 6,
              "height": 6,
              "content": {
                "$ref": "#/spec/panels/c2012d24-e9c4-5975-a153-e2360c105eeb"
              }
            },
            {
              "x": 6,
              "y": 0,
              "width": 6,
              "height": 6,
              "content": {
                "$ref": "#/spec/panels/cd41f224-96e1-5fc2-b44e-8c09737f49fa"
              }
            },
            {
              "x": 0,
              "y": 6,
              "width": 6,
              "height": 6,
              "content": {
                "$ref": "#/spec/panels/001a3b01-7639-53c9-801d-efc7c773e87e"
              }
            },
            {
              "x": 6,
