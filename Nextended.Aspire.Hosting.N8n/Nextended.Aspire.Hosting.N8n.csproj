<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\Shared.props" />

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>


  <PropertyGroup>
    <Description>This Library provides an Aspire n8n workflow automation solution</Description>
    <PackageTags>Aspire, extensions, n8n, workflow, automation</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nextended.Aspire\Nextended.Aspire.csproj" />
    <PackageReference Include="Aspire.Hosting.Azure.AppContainers" Version="$(AspireVersion)" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="$(AspireVersion)" />
    <PackageReference Include="Aspire.Hosting.Docker" Version="$(AspireVersion)" />
  </ItemGroup>

</Project>
