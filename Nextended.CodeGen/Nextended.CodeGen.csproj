<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\Output.props" />
  <Import Project="..\Package.props" />

  <!-- ─────────────  Allgemeine Eigenschaften  ───────────── -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>

    <!-- Source‑Generator‑Flags -->
    <IsRoslynComponent>true</IsRoslynComponent>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>

    <!-- Abhängigkeiten in bin\* kopieren -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <!-- NuGet‑Metadaten -->
    <RepositoryUrl>https://github.com/fgilde/Nextended/tree/main/Nextended.CodeGen</RepositoryUrl>
    <Description>Generate DTOs, interfaces and more from JSON, XML, Excel or existing classes.</Description>
    <PackageTags>SourceGeneration;Excel;JsonToClass;DTO</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <!-- ─────────────  Build‑Time‑Pakete  ───────────── -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" IncludeAssets="runtime;build;native;contentfiles;analyzers;buildtransitive" />
  </ItemGroup>

  <!-- ─────────────  Laufzeit‑Dependencies (Generator‑intern)  ───────────── -->
  <ItemGroup>
    <!-- Öffentliche Attribute + Hilfs‑API -->
    <PackageReference Include="Nextended.Core" GeneratePathProperty="true" />
    <!-- Rest nur intern -->
    <PackageReference Include="ClosedXML" PrivateAssets="all" />
    <PackageReference Include="ColorCode.HTML" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" PrivateAssets="all" />
    <PackageReference Include="DocumentFormat.OpenXml" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" PrivateAssets="all" />
  </ItemGroup>

  <!-- ─────────────  Zusatzdateien fürs NuGet  ───────────── -->

  <!-- ─────────────  Alles aus bin\* in analyzers/dotnet/cs packen  ─────────────
       Muss über TargetsForTfmSpecificContentInPackage laufen: ein <None Include="$(OutputPath)\*.dll">
       würde zur Evaluationszeit globben – also BEVOR der Build die Abhängigkeiten ins Output kopiert.
       Bei einem sauberen Build (CI) ist der Ordner dann leer und das Analyzer-Paket bliebe leer.
       Dieser Target-basierte Glob läuft zur Pack-Zeit, nach dem Build, und findet alle DLLs. -->
  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_PackAnalyzerDependencies</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <Target Name="_PackAnalyzerDependencies">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(OutputPath)*.dll"
                              Exclude="$(OutputPath)System*.dll;$(OutputPath)Microsoft*.dll;$(OutputPath)mscorlib.dll;$(OutputPath)netstandard.dll">
        <PackagePath>analyzers/dotnet/cs</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>
  <ItemGroup>
    <Folder Include="Generators\CodeToText\" />
  </ItemGroup>

  <Target Name="UpdateGuid" BeforeTargets="BeforeBuild">
    <Exec Command="pwsh -NoProfile -File $(SolutionDir)$(AssemblyName)\UpdateGuid.ps1 $(MSBuildProjectDirectory)\Generator.cs BuildId" />
  </Target>
  <Target Name="UpdateGuid" BeforeTargets="AfterBuild">
    <Exec Command="pwsh -NoProfile -File $(SolutionDir)$(AssemblyName)\UpdateGuid.ps1 $(MSBuildProjectDirectory)\Generator.cs BuildId" />
  </Target>
</Project>
