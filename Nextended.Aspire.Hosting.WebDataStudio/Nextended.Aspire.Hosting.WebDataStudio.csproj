<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\Shared.props" />

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup>
    <Description>Run WebDataStudio — a browser-based database studio for PostgreSQL, MySQL, SQL Server, SQLite, Oracle, DuckDB, ClickHouse, MongoDB and Redis — inside your Aspire stack. Attach any resource with a connection string via WithWebDataStudio() or WithReference(), share one studio across databases or run several, add accounts with roles, point its optional SQL assistant at Claude, ChatGPT, OpenRouter or a local Ollama, and serve it as an MCP server for AI agents — all from the app host.</Description>
    <PackageTags>Aspire, extensions, webdatastudio, database, sql, postgresql, mysql, sqlserver, mongodb, redis, tooling</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="$(AspireVersion)" />
    <!-- For Enum<T>.DescriptionFor: the theme enum's description is the studio's own theme id. -->
    <ProjectReference Include="..\Nextended.Aspire\Nextended.Aspire.csproj" />
  </ItemGroup>

</Project>
